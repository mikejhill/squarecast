rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function anonymous() {
      return signedIn() &&
        request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function boardData(boardId) {
      return get(/databases/$(database)/documents/boards/$(boardId)).data;
    }

    function nextBoardData(boardId) {
      return getAfter(/databases/$(database)/documents/boards/$(boardId)).data;
    }

    function member(data) {
      return signedIn() && request.auth.uid in data.memberUids;
    }

    function activeGuest(boardId, data) {
      let sessionPath = /databases/$(database)/documents/boards/$(boardId)/editorSessions/$(request.auth.uid);
      let token = get(sessionPath).data.inviteToken;
      let invitePath = /databases/$(database)/documents/editorInvites/$(token);
      return anonymous() && exists(sessionPath) && token is string &&
        data.shareTokens.invite == token && exists(invitePath) &&
        get(invitePath).data.boardId == boardId;
    }

    function editor(boardId, data) {
      return (member(data) && data.roles[request.auth.uid] in ['owner', 'editor']) ||
        activeGuest(boardId, data);
    }

    function owner(data) {
      return verified() && data.ownerUid == request.auth.uid &&
        data.roles[request.auth.uid] == 'owner';
    }

    function validPayload(data) {
      return data.stateHash is string && data.stateHash.size() <= 768000 &&
        data.title is string && data.title.size() <= 1000;
    }

    function validEditorUpdate(boardId) {
      return editor(boardId, resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'stateHash', 'revision', 'recentOperationIds',
          'checkpointRevisions', 'updatedAt', 'updatedBy', 'lastOperation'
        ]) &&
        request.resource.data.revision == resource.data.revision + 1 &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.recentOperationIds.size() <= 50 &&
        request.resource.data.checkpointRevisions.size() <= 25 &&
        request.resource.data.lastOperation.id is string &&
        request.resource.data.lastOperation.targets is list &&
        request.resource.data.lastOperation.targets.size() <= 20 &&
        request.resource.data.lastOperation.uid == request.auth.uid &&
        request.resource.data.recentOperationIds.hasAny([
          request.resource.data.lastOperation.id
        ]) &&
        validPayload(request.resource.data);
    }

    function validOwnerUpdate() {
      return owner(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ownerUid', 'memberUids', 'roles', 'shareTokens',
          'updatedAt', 'updatedBy'
        ]) &&
        request.resource.data.memberUids.size() <= 20 &&
        request.resource.data.ownerUid in request.resource.data.memberUids &&
        request.resource.data.roles.size() == request.resource.data.memberUids.size() &&
        request.resource.data.roles[request.resource.data.ownerUid] == 'owner' &&
        (request.resource.data.ownerUid == resource.data.ownerUid ||
          (request.resource.data.ownerUid in resource.data.memberUids &&
            resource.data.roles[request.resource.data.ownerUid] == 'editor' &&
            request.resource.data.roles[resource.data.ownerUid] == 'editor')) &&
        validPayload(request.resource.data);
    }

    function validInviteJoin(boardId) {
      let token = request.resource.data.lastAcceptedInvite;
      let invitePath = /databases/$(database)/documents/editorInvites/$(token);
      let invite = get(invitePath);
      return signedIn() && !anonymous() && token is string && exists(invitePath) &&
        invite.data.boardId == boardId && invite.data.role == 'editor' &&
        !(request.auth.uid in resource.data.memberUids) &&
        request.auth.uid in request.resource.data.memberUids &&
        request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
        request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1 &&
        request.resource.data.memberUids.size() <= 20 &&
        request.resource.data.roles.size() == request.resource.data.memberUids.size() &&
        request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid]) &&
        request.resource.data.roles[request.auth.uid] == 'editor' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberUids', 'roles', 'lastAcceptedInvite', 'updatedAt', 'updatedBy'
        ]) &&
        request.resource.data.updatedBy == request.auth.uid;
    }

    function validSelfRemoval() {
      return member(resource.data) && resource.data.ownerUid != request.auth.uid &&
        !(request.auth.uid in request.resource.data.memberUids) &&
        request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1 &&
        request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'roles']);
    }

    function validEditorSession(boardId, uid) {
      let token = request.resource.data.inviteToken;
      let invitePath = /databases/$(database)/documents/editorInvites/$(token);
      return anonymous() && request.auth.uid == uid && token is string &&
        exists(invitePath) && get(invitePath).data.boardId == boardId &&
        boardData(boardId).shareTokens.invite == token &&
        request.resource.data.keys().hasOnly([
          'schemaVersion', 'inviteToken', 'createdAt'
        ]) &&
        request.resource.data.schemaVersion == 1 &&
        request.resource.data.createdAt == request.time;
    }

    match /boards/{boardId} {
      allow get: if member(resource.data) || activeGuest(boardId, resource.data);
      allow list: if member(resource.data);
      allow create: if verified() &&
        request.resource.data.schemaVersion == 1 &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.memberUids == [request.auth.uid] &&
        request.resource.data.memberUids.size() == 1 &&
        request.resource.data.roles.size() == 1 &&
        request.resource.data.roles[request.auth.uid] == 'owner' &&
        request.resource.data.shareTokens.size() == 0 &&
        request.resource.data.revision == 1 &&
        request.resource.data.recentOperationIds.size() == 0 &&
        request.resource.data.checkpointRevisions.size() == 0 &&
        validPayload(request.resource.data);
      allow update: if validEditorUpdate(boardId) || validOwnerUpdate() ||
        validInviteJoin(boardId) || validSelfRemoval();
      allow delete: if owner(resource.data);

      match /checkpoints/{revision} {
        allow read: if member(boardData(boardId)) || activeGuest(boardId, boardData(boardId));
        allow create: if editor(boardId, nextBoardData(boardId)) &&
          request.resource.data.schemaVersion == 1 &&
          request.resource.data.revision == nextBoardData(boardId).revision &&
          request.resource.data.stateHash == nextBoardData(boardId).stateHash &&
          request.resource.data.reason is string &&
          request.resource.data.createdBy == request.auth.uid;
        allow delete: if editor(boardId, nextBoardData(boardId)) &&
          !(resource.data.revision in nextBoardData(boardId).checkpointRevisions);
        allow update: if false;
      }

      match /presence/{sessionId} {
        allow read: if member(boardData(boardId)) || activeGuest(boardId, boardData(boardId));
        allow create, update: if editor(boardId, boardData(boardId)) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.displayName is string;
        allow delete: if editor(boardId, boardData(boardId)) &&
          (resource.data.uid == request.auth.uid || owner(boardData(boardId)));
      }

      match /editorSessions/{uid} {
        allow get: if signedIn() &&
          (request.auth.uid == uid || owner(boardData(boardId)));
        allow list: if owner(boardData(boardId));
        allow create, update: if validEditorSession(boardId, uid);
        allow delete: if signedIn() &&
          (request.auth.uid == uid || owner(boardData(boardId)));
      }
    }

    match /publicShares/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if owner(nextBoardData(request.resource.data.boardId)) &&
        request.resource.data.schemaVersion == 1 &&
        request.resource.data.kind in ['view', 'play'] &&
        request.resource.data.stateHash == nextBoardData(request.resource.data.boardId).stateHash &&
        request.resource.data.revision == nextBoardData(request.resource.data.boardId).revision;
      allow update: if editor(resource.data.boardId, nextBoardData(resource.data.boardId)) &&
        request.resource.data.schemaVersion == resource.data.schemaVersion &&
        request.resource.data.boardId == resource.data.boardId &&
        request.resource.data.kind == resource.data.kind &&
        request.resource.data.stateHash == nextBoardData(resource.data.boardId).stateHash &&
        request.resource.data.revision == nextBoardData(resource.data.boardId).revision;
      allow delete: if owner(boardData(resource.data.boardId));
    }

    match /editorInvites/{token} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if owner(boardData(request.resource.data.boardId)) &&
        request.resource.data.keys().hasOnly([
          'schemaVersion', 'boardId', 'role', 'ownerUid', 'createdAt'
        ]) &&
        request.resource.data.schemaVersion == 1 &&
        request.resource.data.role == 'editor' &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if owner(boardData(resource.data.boardId));
    }
  }
}
