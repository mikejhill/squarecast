{
  "name": "squarecast",
  "version": "1.0.0",
  "description": "URL-native bingo board studio for building, sharing, and playing randomized boards.",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run test:coverage && npm run build"
  },
  "dependencies": {
    "loglevel": "^1.9.2",
    "lucide-react": "^0.468.0",
    "lz-string": "^1.5.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.7.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "type": "module"
}
